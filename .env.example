# Copy this file to a new file named exactly  .env  (in this same folder)
# and fill in the values. The .env file is private and is never uploaded to git.

# The bot's password from the Discord Developer Portal. Paste it after the = sign, no quotes, no spaces.
DISCORD_TOKEN=paste-bot-token-here

# Right-click the "Dispatch HQ" server icon > Copy Server ID (needs Developer Mode on)
DISCORD_GUILD_ID=000000000000000000

# Right-click your own name > Copy User ID
MAX_USER_ID=000000000000000000

# Optional: channel IDs. Leave blank and the bot finds channels named today / inbox / scoreboard.
CHANNEL_TODAY=
CHANNEL_INBOX=
CHANNEL_SCOREBOARD=

# Optional: where the local Qwen model runs (Ollama). Leave as is.
OLLAMA_URL=http://127.0.0.1:11434

# ---- Phase 2 (all optional; blank = off / automatic) ----

# Which local AI model reads your chat messages. Blank = automatic: qwen3.5:27b, then qwen3.5:4b.
QWEN_MODEL=

# Canvas calendar feed link (Canvas -> Calendar -> Calendar Feed). It works like a password for
# your Canvas calendar: never paste it into a chat. Blank = no Canvas import. See SETUP.md.
CANVAS_ICS_URL=

# Only the long NUMBER from your #inbox webhook link (the part between webhooks/ and the next /).
# Never put the whole webhook link here. Blank = Siri shortcut off. See SETUP.md.
INBOX_WEBHOOK_ID=

# ---- Phone line (optional; key + assistant + code + your number = on). SETUP.md "Phone line". ----
# Vapi PRIVATE API key - a password: never paste it into a chat.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# 4-digit code the line asks for before reading anything out.
VOICE_PIN=
# Your cell number, e.g. +16145551234. Only calls from this number can change anything.
MAX_PHONE=
# A Vapi number that can make calls (paid). Blank = Dispatch never calls you.
VAPI_OUTBOUND_NUMBER_ID=
# Stop calling you once this month's Vapi spend reaches this many dollars.
VOICE_BUDGET_USD=13
